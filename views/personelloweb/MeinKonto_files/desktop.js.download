function subscribeToNewsletterCallback(str_mail,str_language,is_foboCustomer=!1){const formData=new FormData();formData.append("email",str_mail);let str_url="https://mailer.personello.com/f/259909-299451/wcs/";switch(str_language){case "FR":str_url="https://mailer.personello.com/f/259909-300813/wcs/";break;case "EN":str_url="https://mailer.personello.com/f/259909-300812/wcs/";break;case "ES":str_url="https://mailer.personello.com/f/259909-300804/wcs/";break;case "IT":str_url="https://mailer.personello.com/f/259909-300814/wcs/";break;case "NL":str_url="https://mailer.personello.com/f/259909-299458/wcs/";break;case "DE":default:if(is_foboCustomer){str_url="https://mailer.personello.com/f/259909-344862/wcs/"}}
return window.fetch(str_url,{method:'POST',cache:'no-cache',headers:{'Content-Type':'application/x-www-form-urlencoded'},redirect:'follow',referrerPolicy:'unsafe-url',body:new URLSearchParams(formData)}).catch(function(){})}
function subscribeToNewsletterWithMail(str_mail,str_source,is_foboCustomer=!1){let str_language="DE";try
{str_language=document.documentElement.lang.toUpperCase()}catch(e){}
return subscribeToNewsletterCallback(str_mail,str_language,is_foboCustomer).then(function(){window.dataLayer.push({'event':'newsletterabonniert','lochref':str_source,'formularort':window.location.href})})}
function subscribeToNewsletter(str_id,str_source,is_foboCustomer=!1){let str_successMessage='Bitte prüfe dein Postfach und klicke den Bestätigungslink, um die Anmeldung abzuschließen';let str_errorMessage='Ungültige E-Mail-Adresse';let str_language="DE";try
{str_language=document.documentElement.lang.toUpperCase()}catch(e){}
switch(str_language){case "FR":str_successMessage='Veuillez vérifier dans votre boîte mail et cliquer sur le lien de confirmation afin de finaliser l\'inscription.';str_errorMessage='Adresse e-mail invalide';break;case "EN":str_successMessage='Please check your inbox and click on the confirmation link to complete your registration.';str_errorMessage='Invalid email address';break;case "ES":str_successMessage='Por favor revisa tu buzón de correo y haz clic en el enlace de confirmación para completar el registro.';str_errorMessage='Dirección de E-Mail no válida';break;case "IT":str_successMessage='Controlla la tua casella di posta e clicca sul link di conferma per completare l\’iscrizione.';str_errorMessage='Indirizzo e-mail non valido';break;case "NL":str_successMessage='Kijk even in jouw mailbox en klik op de link om het inschrijven te bevestigen.';str_errorMessage='Ongeldig e-mailadres';break}
$(".newsletterSubscriptionLoading").show();let str_mailAddress=String($('#'+str_id).val());if(str_mailAddress.indexOf("@")<0){$("[id^=subscribeError]").text(str_errorMessage).css("display","block");$(".newsletterSubscriptionLoading").hide();return}
return subscribeToNewsletterWithMail(str_mailAddress,str_source,is_foboCustomer).then(function(){$("[id^=subscribeSuccess]").css("display","block").html(str_successMessage);$("[id^=subscribeError]").html('').css("display","none");$(".newsletterSubscriptionLoading").hide()})}
function subscribe(str_inputname,str_buttontohide,str_source,obj_deferred){str_source=!str_source?"pso-site":str_source;let str_successMessage='Anmeldung erfolgreich';let str_language="DE";try
{str_language=document.documentElement.lang.toUpperCase()}catch(e){}
switch(str_language){case "FR":str_successMessage='Anmeldung erfolgreich';break;case "EN":str_successMessage='Anmeldung erfolgreich';break;case "ES":str_successMessage='Anmeldung erfolgreich';break;case "IT":str_successMessage='Anmeldung erfolgreich';break;case "NL":str_successMessage='Anmeldung erfolgreich';break}
subscribeToNewsletterCallback($('#'+str_inputname).val(),str_language).then(function(){$("[id^=subscribeSuccess]").css("display","block").html(str_successMessage);$("[id^=subscribeError]").html('').css("display","none");window.dataLayer.push({'event':'newsletterabonniert','lochref':str_source,'formularort':window.location.href});if(obj_deferred){obj_deferred.resolve("done")}})}
