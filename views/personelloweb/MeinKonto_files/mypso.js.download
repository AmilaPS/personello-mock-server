function logOutMyPso($,str_url,str_csrf){$.ajax({type:'POST',url:str_url,dataType:'json',data:{"frmStr_csrf":str_csrf},success:function(data){window.location.href=data.redirect},error:function(){window.location.reload()}})}
function deleteMyPsoAddress($,str_url,str_csrf,str_addressId){$.ajax({type:'POST',url:str_url,dataType:'json',data:{"frmStr_csrf":str_csrf,"frmStr_addressId":str_addressId},success:function(){window.location.reload()},error:function(){window.location.reload()}})}
var setDefaultMyPsoAddress=deleteMyPsoAddress;function deleteMyPsoUser($,str_url,str_csrf){$.ajax({type:'POST',url:str_url,dataType:'json',data:{"frmStr_csrf":str_csrf},success:function(data){window.location.href=data.redirect},error:function(){alert('Es ist ein Fehler aufgetreten. Bitte versuche es erneut.');window.location.reload()}})}
function copyMyPsoDesign($,str_url,str_csrf,str_designId){$.ajax({type:'POST',url:str_url,dataType:'json',data:{"frmStr_csrf":str_csrf,"frmStr_designId":str_designId},success:function(){window.location.reload()},error:function(){alert('Es ist ein Fehler aufgetreten. Bitte versuche es erneut.');window.location.reload()}})}
var deleteMyPsoDesign=copyMyPsoDesign;function useMyPsoDesign($,str_url,str_csrf,str_designId){$.ajax({type:'POST',url:str_url,dataType:'json',data:{"frmStr_csrf":str_csrf,"frmStr_designId":str_designId},success:function(data){if(data.is_success===!0){window.location.href=data.redirect}else{alert('Es ist ein Fehler aufgetreten. Bitte versuche es erneut.');window.location.reload()}},error:function(){alert('Es ist ein Fehler aufgetreten. Bitte versuche es erneut.');window.location.reload()}})}